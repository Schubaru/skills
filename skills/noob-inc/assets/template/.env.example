# GitHub OAuth app (Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# The only GitHub login allowed to sign in
ALLOWED_GITHUB_LOGIN=
# Supabase pooler URL for the dedicated `noob` role
DATABASE_URL=postgres://noob.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Which sides this office serves: both (dashboard + share link), admin (dashboard only), view (public office, no sign-in)
NEXT_PUBLIC_NOOB_MODE=both
# The label beside the wordmark
NEXT_PUBLIC_OFFICE_NAME=Agent floor
